{
  "name": "credence-monorepo",
  "version": "1.0.0",
  "description": "Credence Universal Cross-Chain Verifiable Credit Protocol",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix frontend",
    "test:contracts": "cd contracts && npm test",
    "compile:contracts": "cd contracts && npm run compile",
    "seed:profiles": "cd contracts && npm run seed:profiles",
    "relayer": "cd relayer && npm run worker",
    "sentinel": "cd relayer && npm run sentinel",
    "install:all": "npm install --prefix contracts && npm install --prefix relayer && npm install --prefix frontend"
  },
  "keywords": ["creditcoin", "attestcoin", "usc", "cross-chain", "credit", "defi"],
  "private": true
}
